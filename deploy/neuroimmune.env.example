# 复制为 /etc/neuroimmune.env（systemd 通过 EnvironmentFile 读取），改后 systemctl restart neuroimmune 生效

# 管理员（必填，否则后端拒绝启动）
NEUROIMMUNE_ADMIN_USER=admin
NEUROIMMUNE_ADMIN_PASSWORD=CHANGE_ME

# 机器接入 token（必填，否则 /api/ingest 拒绝接入）
NEUROIMMUNE_API_TOKEN=CHANGE_ME

# 数据目录（SQLite / JSON 状态 / secret.key，建议独立分区并定期备份）
NEUROIMMUNE_DATA_DIR=/var/lib/neuroimmune

# syslog 接收：内网要收日志改 0.0.0.0；仅本机收则 127.0.0.1
NEUROIMMUNE_SYSLOG_BIND=127.0.0.1
NEUROIMMUNE_SYSLOG_PORT=5514

# JWT 密钥（留空则自动生成并持久化到数据目录的 secret.key）
# NEUROIMMUNE_JWT_SECRET=

# 模型接入（留空 = mock 模式先跑通架构；内网无外网时通常用内网 LLM 网关或 mock）
# NEUROIMMUNE_API_KEY=
# NEUROIMMUNE_BASE_URL=https://api.deepseek.com/v1
# NEUROIMMUNE_MODEL=deepseek-chat
# NEUROIMMUNE_DEEP_MODEL=deepseek-reasoner
