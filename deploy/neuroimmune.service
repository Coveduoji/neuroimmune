[Unit]
Description=NeuroImmune 神经免疫工作台（后端 + 前端静态托管）
After=network.target

[Service]
Type=simple
User=neuroimmune
Group=neuroimmune
WorkingDirectory=/opt/neuroimmune/backend
EnvironmentFile=/etc/neuroimmune.env
ExecStart=/opt/neuroimmune/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3

# 数据目录 /var/lib/neuroimmune 需给 neuroimmune 用户写权限
[Install]
WantedBy=multi-user.target
